    <worksheet name='Late Rate by City'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Late delivery rate by city: Upper Egypt is the slowest</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='online_store_orders' name='textscan.store01' />
          </datasources>
          <datasource-dependencies datasource='textscan.store01'>
            <column caption='Late Rate' datatype='real' default-format='p0.0%' name='[Calc_LateRate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Delivery_Status] = &quot;Late&quot; THEN 1 ELSE 0 END) / COUNTD([Order_ID])' />
            </column>
            <column caption='Orders' datatype='integer' default-format='n#,##0' name='[Calc_Orders]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order_ID])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Delivery_Status]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order_Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Order_ID]' role='dimension' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_LateRate]' derivation='User' name='[usr:Calc_LateRate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_Orders]' derivation='User' name='[usr:Calc_Orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order_Date]' derivation='Year' name='[yr:Order_Date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <computed-sort column='[textscan.store01].[none:City:nk]' direction='DESC' using='[textscan.store01].[usr:Calc_LateRate:qk]' />
          <slices>
            <column>[textscan.store01].[none:City:nk]</column>
            <column>[textscan.store01].[none:Category:nk]</column>
            <column>[textscan.store01].[yr:Order_Date:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[textscan.store01].[usr:Calc_LateRate:qk]' />
              <tooltip column='[textscan.store01].[usr:Calc_Orders:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-color' value='#d9480f' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[textscan.store01].[none:City:nk]</rows>
        <cols>[textscan.store01].[usr:Calc_LateRate:qk]</cols>
      </table>
      <simple-id uuid='{868CC307-2BF2-448D-9AAF-32C4352EA6F3}' />
    </worksheet>
